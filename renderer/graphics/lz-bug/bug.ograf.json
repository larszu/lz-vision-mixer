{
  "$schema": "https://ograf.ebu.io/v1/specification/json-schemas/graphics/schema.json",
  "id": "lz-bug",
  "version": "1.0.0",
  "name": "LZ Bug",
  "description": "Small corner bug: text label, optionally with the lz monogram or a tally square (for LIVE). Lars Zumpe Medienproduktion design.",
  "author": { "name": "Lars Zumpe Medienproduktion", "url": "https://zumpelars.de" },
  "main": "graphic.mjs",
  "supportsRealTime": true,
  "supportsNonRealTime": false,
  "stepCount": 1,
  "actionDurations": [
    { "type": "playAction", "duration": 300 },
    { "type": "updateAction", "duration": 300 },
    { "type": "stopAction", "duration": 300 }
  ],
  "schema": {
    "type": "object",
    "properties": {
      "text": { "type": "string", "title": "Text", "default": "Live" },
      "corner": {
        "type": "string",
        "title": "Corner",
        "enum": ["top-left", "top-right", "bottom-left", "bottom-right"],
        "gddOptions": { "labels": { "top-left": "Top left", "top-right": "Top right", "bottom-left": "Bottom left", "bottom-right": "Bottom right" } },
        "default": "top-right"
      },
      "tally": { "type": "boolean", "title": "Tally square", "description": "Red square before the text, for a LIVE label", "default": false },
      "monogram": { "type": "boolean", "title": "lz monogram", "description": "Show the lz monogram (without dot) before the text", "default": false },
      "plate": { "type": "boolean", "title": "Navy plate", "description": "Off: text and monogram directly on the picture", "default": true }
    }
  }
}
